 subgraph T0["🗄️  Tier 0 · VectorDB · up to MAX_LOOPS retries"]
    direction LR
        QR0["query_rewriter<br/>optimize  loop=0"]
        RE0["rag_engine<br/>LangGraph node"]
        RA0["search_msd_manual<br/>tool_choice=req"]
        VDB[("FAISS<br/>BAAI/bge-base-en-v1.5<br/>cosine TOP-K")]
        GA0["LLM synthesis<br/>context + Q"]
        CR0{"critic_agent<br/>F · AR · CP"}
        QRF["query_rewriter<br/>refinement + critic_feedback"]
  end
 subgraph T1["🧠  Tier 1 · LLM Knowledge · 1 attempt  (no external tool)"]
    direction LR
        QR1["query_rewriter<br/>refinement"]
        RE1["rag_engine<br/>LangGraph node"]
        LLM["_search_llm_knowledge<br/>LLM training data only"]
        CR1{"critic_agent<br/>AR only<br/>(F · CP = NULL)"}
  end
 subgraph T2["🌐  Tier 2 · Web Search · 1 attempt  (DuckDuckGo)"]
    direction LR
        QR2["query_rewriter<br/>refinement"]
        RE2["rag_engine<br/>LangGraph node"]
        RA2["search_web<br/>tool_choice=req"]
        WEB[("DuckDuckGo<br/>ReAct agent")]
        GA2["LLM synthesis<br/>context + Q"]
        CR2{"critic_agent<br/>F · AR · CP"}
  end
    A(["START"]) --> LC["level_classifier<br/>Professional / Consumer / Baseline"]
    LC --> QR0
    QR0 --> RE0
    RE0 --> RA0
    RA0 -- query --> VDB
    VDB -. chunks .-> GA0
    GA0 --> CR0
    CR0 -- "Cond A: below threshold<br/>loop &lt; MAX_LOOPS  not critical" --> QRF
    QRF --> RE0
    CR0 -- "F ≥ 0.8 AND AR ≥ 0.8 AND CP ≥ 0.8<br/>OR Cond E (Baseline)" --> OUT["output_agent<br/>FK Grade · Korean trans. · source"]
    CR0 -- "critical: AR&lt;0.3  OR  (F&lt;0.3 AND CP&lt;0.2)<br/>exhausted: loop == MAX_LOOPS" --> QR1
    QR1 --> RE1
    RE1 --> LLM
    LLM --> CR1
    CR1 -- "AR ≥ 0.8" --> OUT
    CR1 -- "AR < 0.8" --> QR2
    QR2 --> RE2
    RE2 --> RA2
    RA2 -- query --> WEB
    WEB -. chunks .-> GA2
    GA2 --> CR2
    CR2 -- "F ≥ 0.8 AND AR ≥ 0.8 AND CP ≥ 0.8" --> OUT
    CR2 -- "all tiers exhausted" --> FB["fallback<br/>best_answer OR raw chunks"]
    FB --> OUT
    OUT --> Z(["END"])

